rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'admin@josi.com' ||
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match any document in the 'users' collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
      
      match /sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId || isAdmin();
      }
      
      match /resumeSubmissions/{submissionId} {
        allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }
    
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || 
        (isAuthenticated() && 
         request.resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      match /roles/{roleId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }
    
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    match /resumes/{resumeId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    match /scores/{scoreId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.studentId || isAdmin());
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }

    match /placement_events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || 
        (isAuthenticated() && 
         request.auth.uid == request.resource.data.createdBy &&
         request.resource.data.company_name is string &&
         request.resource.data.title is string &&
         request.resource.data.description is string &&
         request.resource.data.event_type is string &&
         request.resource.data.start_date is timestamp &&
         request.resource.data.end_date is timestamp &&
         request.resource.data.location is string &&
         request.resource.data.required_documents is list &&
         request.resource.data.eligible_courses is list);
      allow delete: if isAdmin() || 
        (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}